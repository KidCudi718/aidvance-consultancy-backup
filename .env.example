# Server-only. Never prefix these with NEXT_PUBLIC_ or put them in client code.

# Destination for /contact/ submissions. If unset, the server action uses a
# hardcoded fallback inbox that must never appear in the browser.
CONTACT_INBOX=

# Prefer Resend when this is set.
RESEND_API_KEY=

# Optional Resend From address. Defaults to Resend's onboarding sender.
CONTACT_FROM=
